{
  "openapi": "3.1.0",
  "info": {
    "title": "Evidence Engine Voice Router",
    "version": "0.1.0",
    "description": "Single-user self-hosted pilot. Capture preserves words; actions require current-revision confirmation. Native receipts are client-reported. The review token has broader privileges than the intake token."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4181",
      "description": "Local development only; configure your own HTTPS origin for a phone"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "summary": "Public health check",
        "security": [],
        "responses": {
          "200": {
            "description": "Healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "version": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/captures": {
      "post": {
        "operationId": "captureNote",
        "summary": "Preserve the original and propose a route; never dispatch an action",
        "security": [
          {
            "captureToken": []
          },
          {
            "reviewToken": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capture"
