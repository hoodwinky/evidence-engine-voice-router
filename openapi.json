  "components": {
    "securitySchemes": {
      "captureToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Intake only"
      },
      "reviewToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Read, edit plans, confirm dispatch and record native receipts"
      }
    },
    "schemas": {
      "CaptureInput": {
        "type": "object",
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "source": {
            "type": "string",
            "enum": [
              "siri",
              "android",
              "web",
              "api"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "reminder",
              "calendar",
              "automation"
            ]
          },
          "title": {
            "type": "string"
          },
          "dueAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "startAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "endAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "destination": {
            "type": "string"
          },
          "automation": {
            "type": "string"
          }
        }
      },
      "PlanDetails": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "reminder",
              "calendar",
              "automation"
            ]
          },
          "title": {
            "type": "string"
          },
          "dueAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "startAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "endAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "destination": {
            "type": "string"
          },
          "automation": {
            "type": "string"
          }
        }
      },
      "Plan": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "destination",
          "missing"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "note",
              "reminder",
              "calendar",
              "automation"
            ]
          },
          "title": {
            "type": "string"
          },
          "dueAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "startAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "endAt": {
            "type": "string",
            "description": "ISO timestamp with seconds and explicit UTC offset. Invalid/missing dates produce needs_details rather than dropping the note."
          },
          "destination": {
            "type": "string"
          },
          "automation": {
            "type": "string"
          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Capture": {
        "type": "object",
        "required": [
          "id",
          "original",
          "originalSha256",
          "receivedAt",
          "plan",
          "revision",
          "status",
          "result",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "original": {
            "$ref": "#/components/schemas/CaptureInput"
          },
          "originalSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "saved",
              "needs_details",
              "pending_review",
              "dispatching",
              "awaiting_device",
              "completed",
              "delivery_unknown"
            ]
          },
          "result": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "replayed": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "reviewUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
